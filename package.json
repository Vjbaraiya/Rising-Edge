{
  "name": "rising-edge-platform",
  "version": "1.0.0",
  "description": "Rising Edge Innovation Partners platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint server.js lib/ tests/ --ext .js,.cjs",
    "lint:fix": "eslint server.js lib/ tests/ --ext .js,.cjs --fix",
    "format": "prettier --write \"**/*.{js,cjs,html,css,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,cjs,html,css,json}\" --ignore-path .prettierignore",
    "test": "jest --forceExit",
    "test:unit": "jest --testPathPattern=tests/unit --forceExit",
    "test:api": "jest --testPathPattern=tests/api --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "test:ci": "jest --ci --coverage --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "validate": "node --check server.js && node --check lib/planUtils.js",
    "audit": "npm audit --audit-level=critical",
    "prepare": "husky || true"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cashfree-pg": "^6.0.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.1",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "eslint": "^8.57.0",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.5",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "cashfree-pg": {
      "axios": "^1.18.1"
    }
  },
  "allowScripts": {
    "bcrypt": true
  }
}
